{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@sce/utils": ["packages/utils/src/index.ts"],
      "@sce/schemas": ["packages/schemas/src/index.ts"],
      "@sce/db": ["packages/db/src/index.ts"],
      "@sce/prompts": ["packages/prompts/src/index.ts"],
      "@sce/adapters": ["packages/adapters/src/index.ts"],
      "@sce/core": ["packages/core/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "tests/**/*.ts", "*.ts"],
  "exclude": ["node_modules", "dist", "**/dist"]
}
