# Copy to infra/.env and fill in. NEVER commit the filled file.
#   cp infra/.env.example infra/.env
# Every variable here is validated at boot by packages/utils/src/env.ts and documented in
# docs/environment.md.

# ---------------------------------------------------------------- runtime
TZ=Asia/Kolkata
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------- postgres
POSTGRES_USER=sce
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sce
POSTGRES_PORT=5432
# Used by the application and by `pnpm db:migrate` from the host.
DATABASE_URL=postgres://sce:change-me-local-only@localhost:5432/sce
# Used only by the DB-backed test suite. Must end in _test.
TEST_DATABASE_URL=postgres://sce:change-me-local-only@localhost:5432/sce_test

# ---------------------------------------------------------------- redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- n8n
N8N_PORT=5678
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-local-only
# 32+ random chars. Losing this makes stored n8n credentials unreadable.
N8N_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32
N8N_DB_NAME=n8n
N8N_EXECUTION_MAX_AGE_HOURS=336

# ---------------------------------------------------------------- ollama
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_KEEP_ALIVE=10m
OLLAMA_TIMEOUT_MS=120000

# ---------------------------------------------------------------- api
API_PORT=8080
API_BIND=127.0.0.1
# Bearer token required by the capture API when it is not bound to localhost.
CAPTURE_API_TOKEN=
API_RATE_LIMIT_PER_MINUTE=120

# ------------------------------------------------- provider selection (mock by default)
# mock | ollama | failing
LLM_PROVIDER=mock
# mock | searxng | disabled | failing
RESEARCH_PROVIDER=mock
# mock | postiz | failing
PUBLISHING_PROVIDER=mock
# mock | telegram | failing
TELEGRAM_PROVIDER=mock
# dry_run | live   <- live actually sends posts. Never set in development.
PUBLISH_MODE=dry_run

# ---------------------------------------------------------------- telegram (approval loop)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Random string; sent by Telegram in X-Telegram-Bot-Api-Secret-Token and verified on every update.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_TIMEOUT_MS=15000

# ---------------------------------------------------------------- postiz (publishing)
POSTIZ_BASE_URL=
POSTIZ_API_KEY=
POSTIZ_TIMEOUT_MS=20000

# ---------------------------------------------------------------- github (content opportunities)
GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------- research
SEARXNG_BASE_URL=
RESEARCH_TIMEOUT_MS=15000
RESEARCH_MAX_SOURCES=5
