    },
    {
      "parameters": {
        "jsCode": "// Normalize an n8n execution failure into the API's error-report contract.\nconst e = $json.execution ?? {};\nconst wf = $json.workflow ?? {};\nconst lastNode = e.lastNodeExecuted ?? null;\nconst message = (e.error?.message ?? 'workflow execution failed').slice(0, 4000);\nreturn [{\n  json: {\n    workflow: wf.name ?? 'unknown_workflow',\n    step: lastNode,\n    kind: 'transient',\n    code: 'E_N8N_EXECUTION_FAILED',\n    message,\n    correlation_id: e.id ? `cor_n8n_${e.id}` : undefined,\n    details: { execution_url: e.url ?? null, mode: e.mode ?? null, retry_of: e.retryOf ?? null },\n  },\n}];"
      },
      "id": "e830ec65-3200-8d65-0fb9-9a841b25b366",
      "name": "Build error report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SCE_API_BASE_URL }}/internal/errors",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "id": "d0b2cff7-1704-2f16-c064-cf27612b52e4",
